# Local working space — docs, caches, logs, scratchpad, /graphify output,
# everything that isn't meant to go public. One blanket rule instead of the
# pile of individual entries this used to be (single-repo restructure).
dev/

# Config (machine-specific, contains real library path + secrets).
# config.json itself is the tracked bare/minimal template — only the backup
# holding real values is ignored; rename it in locally when you need it.
config.json.bak

# Database — glob (not a fixed filename) so it survives renames like the
# V1 comicvault.db -> V2 comicvault_v2.db -> digib00age.db history, and
# covers dated backups (digib00age_backup_*.db) from POST /api/admin/backup
src/backend/*.db
src/backend/*.db-wal
src/backend/*.db-shm
src/backend/*.db.bak

# Generated thumbnails
src/backend/thumbnails/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Tray app logs
src/tray/tray.log
src/tray/tray_stdout.log
src/tray/reader_stdout.log

# Flutter / Dart
src/flutter_app/build/
src/flutter_app/.dart_tool/
src/flutter_app/android/.gradle/
src/flutter_app/android/app/build/
src/flutter_app/windows/flutter/ephemeral/

# Local tool config
.claude/
CLAUDE.md

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.suo
*.user