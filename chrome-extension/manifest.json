{
  "manifest_version": 3,
  "name": "GoodReads → digib00age Editor Bridge",
  "version": "0.1.0",
  "description": "Scrapes Writer/Artist/Publisher/Year/Summary off a GoodReads book page and pastes them into the digib00age Full Editor. Personal tool, single instance.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:9424/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Scrape this GoodReads page into digib00age",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:9424/editor*"],
      "js": ["content/editor-fill.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
